# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://..."
DIRECT_URL="postgresql://..." # 用于 Prisma Migrate

# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ..."
SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# Email Service (Resend)
RESEND_API_KEY="re_..."

# ==================== OCR Services (Story-044) ====================

# Google Cloud Vision API (主力 OCR)
# 获取: https://console.cloud.google.com/apis/credentials
# 成本: $1.50 / 1000 次请求
GOOGLE_CLOUD_VISION_API_KEY=""

# Mathpix API (数学公式专用，可选)
# 获取: https://mathpix.com/ocr
# 成本: $4 / 1000 次请求
MATHPIX_APP_ID=""
MATHPIX_APP_KEY=""

# 注意: Tesseract.js 为本地 OCR，无需 API Key

# Email (Resend)
RESEND_API_KEY=re_...
NEXT_PUBLIC_FROM_EMAIL='LearnMore <noreply@learnmore.com>'

# App Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Security
CRON_SECRET="your-secret-token-for-cron-jobs"
