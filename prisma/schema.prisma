// ============ 推荐系统模块 ============
enum ReferralStatus {
  PENDING // 被推荐人已注册，但未付费
  COMPLETED // 被推荐人已付费，奖励已发放
  DEFERRED // 被推荐人已付费，但推荐人奖励延迟发放
  EXPIRED // 推荐码过期（可选）
  CANCELLED // 被推荐人退款（可选）
}

enum ReferralAttributionEventType {
  COPY
  CLICK
  BIND
  CHECKOUT
  SETTLE
  REWARD_GRANT
}

model Referral {
  id           String @id @default(uuid()) @db.Uuid
  referrerId   String @map("referrer_id") @db.Uuid // 推荐人 ID
  refereeId    String @map("referee_id") @db.Uuid // 被推荐人 ID
  referralCode String @map("referral_code") // 使用的推荐码

  // 奖励状态
  status                  ReferralStatus    @default(PENDING)
  rewardGranted           Boolean           @default(false) @map("reward_granted") // 奖励是否已发放
  rewardDate              DateTime?         @map("reward_date") // 奖励发放时间
  bindSource              String            @default("UPGRADE") @map("bind_source")
  refereeRewardGrantedAt  DateTime?         @map("referee_reward_granted_at")
  referrerRewardGrantedAt DateTime?         @map("referrer_reward_granted_at")
  deferredRewardTier      SubscriptionTier? @map("deferred_reward_tier")
  deferredRewardWeeks     Int               @default(0) @map("deferred_reward_weeks")
  deferredSettledAt       DateTime?         @map("deferred_settled_at")

  // 追踪信息
  refereeEmail  String    @map("referee_email") // 被推荐人邮箱（冗余，方便查询）
  refereePaidAt DateTime? @map("referee_paid_at") // 被推荐人首次付费时间
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)
  attributionEvents ReferralAttributionEvent[]

  @@unique([refereeId]) // 每个用户只能使用一次推荐码
  @@index([referrerId])
  @@index([status])
  @@map("referrals")
}

model ReferralAttributionEvent {
  id             String                      @id @default(uuid()) @db.Uuid
  referralCode   String                      @map("referral_code")
  eventType      ReferralAttributionEventType @map("event_type")
  success        Boolean                     @default(true)
  errorCode      String?                     @map("error_code")
  referralId     String?                     @map("referral_id") @db.Uuid
  referrerId     String?                     @map("referrer_id") @db.Uuid
  refereeId      String?                     @map("referee_id") @db.Uuid
  sourcePath     String?                     @map("source_path")
  destinationPath String?                    @map("destination_path")
  metadata       Json?
  createdAt      DateTime                    @default(now()) @map("created_at")

  referral Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)
  referrer User?     @relation("ReferralAttributionReferrer", fields: [referrerId], references: [id], onDelete: SetNull)
  referee  User?     @relation("ReferralAttributionReferee", fields: [refereeId], references: [id], onDelete: SetNull)

  @@index([referralCode, createdAt])
  @@index([eventType, createdAt])
  @@index([referrerId, createdAt])
  @@index([refereeId, createdAt])
  @@map("referral_attribution_events")
}

// ============ Content Pipeline 模块 (Story-044) ============

// 处理状态枚举
enum ProcessingStatus {
  PENDING // 等待处理
  PROCESSING // 处理中
  COMPLETED // 处理完成
  FAILED // 处理失败
  SKIPPED // 跳过处理
}

// 内容状态枚举
enum ContentStatus {
  DRAFT // 草稿
  OCR_PROCESSING // OCR处理中
  OCR_COMPLETED // OCR完成
  STRUCTURING // 结构化中
  REVIEW_PENDING // 待审核
  REVIEW_REJECTED // 审核拒绝
  VERIFIED // 已验证
  PUBLISHED // 已发布
  ARCHIVED // 已归档
}

// 标签分类枚举
enum TagCategory {
  SUBJECT // 科目
  TOPIC // 知识点
  DIFFICULTY // 难度
  COGNITIVE_LEVEL // 认知层级（布鲁姆分类）
  QUESTION_TYPE // 题型
  SOURCE // 来源（真题/模拟题）
}

// 审核操作枚举
enum ReviewAction {
  SUBMIT_REVIEW // 提交审核
  APPROVE // 通过
  REJECT // 拒绝
  REQUEST_CHANGE // 请求修改
  PUBLISH // 发布
  ARCHIVE // 归档
}

// 报告问题类型枚举
enum ReportIssueType {
  ANSWER_WRONG // 答案错误
  TYPO // 错别字
  UNCLEAR // 表述不清
  IMAGE_BROKEN // 图片损坏
  LATEX_ERROR // 公式错误
  OTHER // 其他
}

// 报告状态枚举
enum ReportStatus {
  PENDING // 待处理
  REVIEWING // 审核中
  RESOLVED // 已解决
  REJECTED // 无效报告
}

// ==================== 源文件管理 ====================
model SourceFile {
  // 归属字段
  id         String  @id @default(uuid()) @db.Uuid
  subjectId  String? @map("subject_id") @db.Uuid
  uploadedBy String  @map("uploaded_by") @db.Uuid

  // 内容字段
  filename   String
  sourceNote String? @map("source_note")
  fileUrl    String  @map("file_url") // Supabase Storage URL
  fileType   String  @map("file_type") // "pdf" | "image" | "docx"
  fileSize   Int     @map("file_size") // bytes
  ocrRawText String? @map("ocr_raw_text") @db.Text // OCR原始输出
  importDiagnostics Json? @map("import_diagnostics") // 批次诊断：预期题数 / 缺失题号 / 失败原因等

  // 状态 / 审核字段
  status      ProcessingStatus @default(PENDING)
  ocrStatus   ProcessingStatus @default(PENDING) @map("ocr_status")
  createdAt   DateTime         @default(now()) @map("created_at")
  processedAt DateTime?        @map("processed_at")

  // Relations
  questions      Question[]
  questionGroups QuestionGroup[]
  subject        Subject?   @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  uploader       User       @relation("UserUploadedFiles", fields: [uploadedBy], references: [id])

  @@index([uploadedBy])
  @@index([status])
  @@index([subjectId])
  @@map("source_files")
}

// ==================== 审核日志 ====================
model ContentReviewLog {
  id          String @id @default(uuid()) @db.Uuid
  contentType String @map("content_type") // "question" | "question_group"
  contentId   String @map("content_id") @db.Uuid

  action     ReviewAction
  fromStatus ContentStatus @map("from_status")
  toStatus   ContentStatus @map("to_status")

  reviewerId String @map("reviewer_id") @db.Uuid
  reviewer   User   @relation("UserReviewLogs", fields: [reviewerId], references: [id])

  comment String? @db.Text // 审核意见
  changes Json? // 修改内容（JSON diff）

  createdAt DateTime @default(now()) @map("created_at")

  @@index([contentType, contentId])
  @@index([reviewerId])
  @@map("content_review_logs")
}

// ==================== 用户纠错 ====================
model QuestionReport {
  // 归属字段
  id         String @id @default(uuid()) @db.Uuid
  questionId String @map("question_id") @db.Uuid
  reportedBy String @map("reported_by") @db.Uuid

  // 内容字段
  issueType   ReportIssueType @map("issue_type")
  description String          @db.Text

  // 状态 / 审核字段
  status     ReportStatus @default(PENDING)
  reviewedBy String?      @map("reviewed_by") @db.Uuid
  reviewedAt DateTime?    @map("reviewed_at")
  resolution String?      @db.Text // 处理结果
  createdAt  DateTime     @default(now()) @map("created_at")

  // Relations
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  reporter User     @relation("UserQuestionReports", fields: [reportedBy], references: [id])

  @@index([questionId])
  @@index([status])
  @@index([reportedBy])
  @@map("question_reports")
}

// ============ 用户管理后台模块 (Story-046) ============

// 安全操作类型枚举
enum SecurityAction {
  LOGIN
  LOGOUT
  PASSWORD_RESET
  IMPERSONATE_START // 伪装登录：进入
  IMPERSONATE_END // 伪装登录：退出
  USER_BANNED
  USER_UNBANNED
  PERMISSION_OVERRIDE // 权限覆写
  ADMIN_NOTE_ADDED
  ADMIN_NOTE_PINNED
  ADMIN_NOTE_DELETED // 软删除操作
  ADMIN_NOTE_RESTORED // 恢复操作
}

// 客服/运营内部备注（用户不可见，支持软删除）
model AdminNote {
  id       String  @id @default(uuid()) @db.Uuid
  userId   String  @map("user_id") @db.Uuid
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorId String  @map("author_id") @db.Uuid // 操作者 Admin ID
  content  String  @db.Text // Markdown 格式
  isPinned Boolean @default(false) @map("is_pinned")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // 软删除时间

  @@index([userId])
  @@index([userId, deletedAt])
  @@map("admin_notes")
}

// 安全审计日志
model SecurityLog {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    SecurityAction
  ipAddress String?        @map("ip_address")
  userAgent String?        @map("user_agent")
  metadata  Json? // 附加上下文

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, createdAt])
  @@map("security_logs")
}

// 伪装登录会话
model ImpersonationSession {
  id           String    @id @default(uuid()) @db.Uuid
  adminId      String    @map("admin_id") @db.Uuid // 发起伪装的 Admin
  targetUserId String    @map("target_user_id") @db.Uuid // 被伪装的用户
  targetUser   User      @relation(fields: [targetUserId], references: [id], onDelete: Cascade)
  token        String // 签发的 JWT
  startedAt    DateTime  @default(now()) @map("started_at")
  expiresAt    DateTime  @map("expires_at") // Token 过期时间
  endedAt      DateTime? @map("ended_at") // 实际退出时间
  endReason    String?   @map("end_reason") // MANUAL_LOGOUT | TOKEN_EXPIRED | ADMIN_REVOKED

  @@index([targetUserId])
  @@index([adminId, startedAt])
  @@map("impersonation_sessions")
}

model UserPermissionOverride {
  // 归属字段
  id     String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid

  // 内容字段
  targetField   String  @map("target_field") // 'subscriptionTier' | 'subscriptionEnd'
  previousValue String? @map("previous_value")
  newValue      String? @map("new_value")
  reason        String  @db.Text

  // 来源 / 操作字段
  overriddenBy String @map("overridden_by") @db.Uuid // Admin ID

  // 状态 / 审计字段
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime? @map("expires_at") // Optional: auto-expire the override

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_permission_overrides")
}

// ============ 通知与反馈模块 (Story-047) ============

enum NotificationType {
  SYSTEM // 系统公告
  SOCIAL // 社交通知 (帖子回复、评论)
  BILLING // 支付通知 (收据、试用到期) — 不允许用户关闭
  STUDY_REMINDER // 学习提醒
  ACHIEVEMENT // 成就达成
  FEEDBACK_REPLY // 反馈回复
  WEEKLY_REPORT // 学习周报
  PROMOTION // 优惠活动
}

model Notification {
  id         String           @id @default(uuid()) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  type       NotificationType
  title      String
  content    String           @db.Text
  link       String? // 点击跳转链接
  isRead     Boolean          @default(false) @map("is_read")
  isArchived Boolean          @default(false) @map("is_archived")
  metadata   Json? // 附加数据 (如题目ID、奖励金额等)

  createdAt DateTime  @default(now()) @map("created_at")
  readAt    DateTime? @map("read_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  userId String @id @map("user_id") @db.Uuid

  // 站内通知开关
  inAppSystem      Boolean @default(true) @map("in_app_system")
  inAppSocial      Boolean @default(true) @map("in_app_social")
  inAppStudy       Boolean @default(true) @map("in_app_study")
  inAppAchievement Boolean @default(true) @map("in_app_achievement")

  // 邮件通知开关
  emailSystem    Boolean @default(true) @map("email_system")
  emailSocial    Boolean @default(true) @map("email_social")
  emailWeekly    Boolean @default(true) @map("email_weekly")
  emailMarketing Boolean @default(true) @map("email_marketing")
  emailBilling   Boolean @default(true) @map("email_billing") // 始终为 true，仅用于占位或逻辑记录

  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

enum FeedbackCategory {
  BUG // 漏洞反馈
  FEATURE // 功能建议 (原有)
  SUGGESTION // 功能建议 (新版)
  BILLING // 支付问题
  CONTENT_ISSUE // 内容错误 (如题目错误)
  OTHER // 其他
}

enum FeedbackStatus {
  PENDING // 待处理
  IN_PROGRESS // 处理中
  RESOLVED // 已解决
  REJECTED // 已拒绝
  CLOSED // 已关闭
}

enum FeedbackEventType {
  SUBMITTED
  STATUS_CHANGED
  REPLIED
  CLOSED
}

model UserFeedback {
  // 归属字段
  id     String  @id @default(uuid()) @db.Uuid
  userId String? @map("user_id") @db.Uuid // 可选，支持匿名

  // 内容字段
  email       String? // 匿名用户的联系邮箱
  category    FeedbackCategory
  title       String
  content     String           @db.Text
  attachments String[] // 附件图片 URL 列表
  sourceType  String?          @map("source_type")
  sourcePath  String?          @map("source_path")
  priority    Int              @default(0) // 优先级 0-3

  // 状态 / 审核字段
  status     FeedbackStatus @default(PENDING)
  adminReply String?        @map("admin_reply") @db.Text
  repliedAt  DateTime?      @map("replied_at")
  repliedBy  String?        @map("replied_by") @db.Uuid // Admin ID
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  // Relations
  user      User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  responder User?                @relation("FeedbackResponder", fields: [repliedBy], references: [id], onDelete: SetNull)
  events    UserFeedbackEvent[]

  @@index([userId])
  @@index([status])
  @@map("user_feedbacks")
}

model UserFeedbackEvent {
  id         String            @id @default(uuid()) @db.Uuid
  feedbackId String            @map("feedback_id") @db.Uuid
  actorId    String?           @map("actor_id") @db.Uuid
  eventType  FeedbackEventType @map("event_type")
  fromStatus FeedbackStatus?   @map("from_status")
  toStatus   FeedbackStatus?   @map("to_status")
  message    String?           @db.Text
  metadata   Json?
  createdAt  DateTime          @default(now()) @map("created_at")

  feedback UserFeedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  actor    User?        @relation("FeedbackEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([feedbackId, createdAt])
  @@index([actorId])
  @@map("user_feedback_events")
}

enum VoucherDiscountType {
  AMOUNT
  PERCENT
}

model VoucherCode {
  id             String              @id @default(uuid()) @db.Uuid
  code           String              @unique
  discountType   VoucherDiscountType @map("discount_type")
  discountValue  Int                 @map("discount_value")
  maxRedemptions Int?                @map("max_redemptions")
  redeemedCount  Int                 @default(0) @map("redeemed_count")
  isActive       Boolean             @default(true) @map("is_active")
  validFrom      DateTime?           @map("valid_from")
  validTo        DateTime?           @map("valid_to")
  stripeCouponId String?             @map("stripe_coupon_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  redemptions VoucherRedemption[]

  @@index([isActive, validFrom, validTo])
  @@map("voucher_codes")
}

model VoucherRedemption {
  id              String   @id @default(uuid()) @db.Uuid
  voucherId       String   @map("voucher_id") @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  stripeSessionId String?  @map("stripe_session_id")
  appliedAmount   Int      @default(0) @map("applied_amount")
  createdAt       DateTime @default(now()) @map("created_at")

  voucher VoucherCode @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([voucherId, userId], map: "voucher_redemptions_voucher_user_key")
  @@index([voucherId])
  @@index([userId, createdAt])
  @@map("voucher_redemptions")
}
