generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============ 用户模块 ============
model User {
  // 身份 / 归属字段
  id       String            @id @default(uuid()) @db.Uuid
  email    String            @unique
  username String?           @unique
  handle   String?           @unique
  role     UserRole          @default(STUDENT)
  status   UserAccountStatus @default(ACTIVE)

  // 内容 / 资料字段
  avatar String?
  grade  Int? // 年级 (7-9)
  school String? @map("school")

  // 成长 / 统计字段
  streak         Int       @default(0)
  totalStudyTime Int       @default(0) @map("total_study_time") // seconds
  xp             Int       @default(0)
  aiTokenBalance Int       @default(5) @map("ai_token_balance") // Free daily quota or permanent balance
  lastStudyDate  DateTime? @map("last_study_date")
  lastSignInAt   DateTime? @map("last_sign_in_at")
  signInCount    Int       @default(0) @map("sign_in_count")

  // 来源 / 推荐字段
  utmSource     String? @map("utm_source")
  utmMedium     String? @map("utm_medium")
  utmCampaign   String? @map("utm_campaign")
  referralCode  String? @unique @map("referral_code")
  referralCount Int     @default(0) @map("referral_count")
  referralLimit Int     @default(10) @map("referral_limit")

  // 状态 / 订阅字段
  subscriptionTier     SubscriptionTier?  @default(STARTER) @map("subscription_tier")
  subscriptionStart    DateTime?          @map("subscription_start")
  subscriptionEnd      DateTime?          @map("subscription_end")
  subscriptionStatus   SubscriptionStatus @default(CANCELED) @map("subscription_status")
  cancelAtPeriodEnd    Boolean            @default(false) @map("cancel_at_period_end")
  stripeCustomerId     String?            @map("stripe_customer_id")
  stripeSubscriptionId String?            @map("stripe_subscription_id")
  firstPaidAt          DateTime?          @map("first_paid_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  // Relations
  settings           UserSettings?
  progress           UserProgress[]
  attempts           UserAttempt[]
  examRecords        ExamRecord[]
  posts              Post[]
  comments           Comment[]
  leaderboardEntries LeaderboardEntry[]
  badges             UserBadge[]
  dailyTasks         DailyTask[]
  postLikes          PostLike[]
  postBookmarks      PostBookmark[]
  rewardAdjustments  RewardAdjustmentRecord[] @relation("RewardAdjustmentTargetUser")

  // Parent-Student Relations
  parents     ParentStudent[] @relation("StudentToParent")
  students    ParentStudent[] @relation("ParentToStudent")
  inviteCodes InviteCode[]

  // Referral Relations
  referralsGiven    Referral[] @relation("Referrer") // 我推荐的人
  referralsReceived Referral[] @relation("Referee") // 推荐我的人
  referralAttributionEventsAsReferrer ReferralAttributionEvent[] @relation("ReferralAttributionReferrer")
  referralAttributionEventsAsReferee  ReferralAttributionEvent[] @relation("ReferralAttributionReferee")

  // 🆕 Content Pipeline 关联 (Story-044)
  uploadedSourceFiles SourceFile[]       @relation("UserUploadedFiles")
  reviewLogs          ContentReviewLog[] @relation("UserReviewLogs")
  questionReports     QuestionReport[]   @relation("UserQuestionReports")

  // 🆕 用户管理后台关联 (Story-046)
  adminNotes            AdminNote[]
  securityLogs          SecurityLog[]
  impersonationSessions ImpersonationSession[]
  permissionOverrides   UserPermissionOverride[]

  // 🆕 通知与反馈关联 (Story-047)
  notifications          Notification[]
  notificationPreference NotificationPreference?
  feedbacks              UserFeedback[]
  feedbackReplies        UserFeedback[]      @relation("FeedbackResponder")
  feedbackEvents         UserFeedbackEvent[] @relation("FeedbackEventActor")
  voucherRedemptions     VoucherRedemption[]

  @@map("users")
}

model ReservedHandle {
  id        String   @id @default(uuid()) @db.Uuid
  handle    String   @unique
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  @@map("reserved_handles")
}

model ParentStudent {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String   @map("parent_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  parent  User @relation("ParentToStudent", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("StudentToParent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@map("parent_students")
}

model InviteCode {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  studentId String   @map("student_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("invite_codes")
}

model UserSettings {
  // 归属字段
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  // 内容字段
  theme                 String        @default("dark")
  language              String        @default("en") // 'en', 'zh', 'ms'
  aiPersonality         AiPersonality @default(ENCOURAGING) @map("ai_personality")
  difficultyCalibration Int           @default(50) @map("difficulty_calibration") // 0-100
  curriculumSystem      String?       @map("curriculum_system") // e.g. "UEC", "IGCSE"
  studyReminderTime     String?       @map("study_reminder_time") // e.g. "20:00"
  notificationDaily     Boolean       @default(true) @map("notification_daily") // Push/In-app
  notificationWeekly    Boolean       @default(true) @map("notification_weekly") // Push/In-app
  emailMarketing        Boolean       @default(true) @map("email_marketing")
  emailActivity         Boolean       @default(true) @map("email_activity")

  // 状态 / 审计字段
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

enum AiPersonality {
  ENCOURAGING
  SOCRATIC
  STRICT
}

enum SubscriptionTier {
  STARTER
  STANDARD
  SMART_PLUS
  PREMIER
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  CANCEL_AT_PERIOD_END
  CANCELED
  PAST_DUE
}

enum UserRole {
  STUDENT
  PARENT
  TEACHER
  ADMIN
}

enum UserAccountStatus {
  ACTIVE
  BANNED
  PAUSED
}

model Subscriber {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  subscribedAt DateTime @default(now()) @map("subscribed_at")

  @@map("subscribers")
}

// ============ 成就系统 ============
model Badge {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique // e.g. "early_bird", "math_master"
  name        String
  description String
  icon        String // URL or icon name
  condition   String? // Description of how to unlock
  createdAt   DateTime @default(now()) @map("created_at")

  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  // 归属字段
  id      String @id @default(uuid()) @db.Uuid
  userId  String @map("user_id") @db.Uuid
  badgeId String @map("badge_id") @db.Uuid

  // 状态 / 审计字段
  awardedAt DateTime @default(now()) @map("awarded_at")

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

// ============ 课程模块 ============
model Subject {
  // 归属字段
  id   String @id @default(uuid()) @db.Uuid
  key  String @unique // chinese, malay, english, math, science, history, geography, other
  name String @unique // 数学, 物理, 化学...

  // 内容字段
  icon String?

  // 状态 / 排序字段
  order Int @default(0)

  // Relations
  chapters    Chapter[]
  posts       Post[]
  examRecords ExamRecord[] // 🆕 练习记录关联 (Story-043)
  questions   Question[]
  questionGroups QuestionGroup[]
  sourceFiles SourceFile[]

  @@map("subjects")
}

model Chapter {
  // 归属字段
  id        String  @id @default(uuid()) @db.Uuid
  subjectId String  @map("subject_id") @db.Uuid
  parentId  String? @map("parent_id") @db.Uuid // 自关联实现树形结构

  // 内容字段
  title String

  // 布局 / 缓存字段
  x               Float?
  y               Float?
  totalQuestions  Int       @default(0) @map("total_questions") // 该章节题目总数
  avgDifficulty   Float?    @map("avg_difficulty") // 平均难度
  cachedMastery   Json?     @map("cached_mastery") // { [userId]: masteryLevel }
  lastCacheUpdate DateTime? @map("last_cache_update") // 缓存最后更新时间

  // 状态 / 排序字段
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent    Chapter?   @relation("ChapterTree", fields: [parentId], references: [id])
  children  Chapter[]  @relation("ChapterTree")
  lessons   Lesson[]
  questions Question[]
  questionGroups QuestionGroup[]

  @@index([subjectId])
  @@index([parentId])
  @@map("chapters")
}

model Lesson {
  id        String     @id @default(uuid()) @db.Uuid
  chapterId String     @map("chapter_id") @db.Uuid
  title     String
  type      LessonType @default(VIDEO)
  videoUrl  String?    @map("video_url")
  content   String?    @db.Text // Markdown 内容
  duration  Int? // 视频时长(秒)
  xpReward  Int        @default(10) @map("xp_reward")
  order     Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at")

  // Relations
  chapter  Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progress UserProgress[]

  @@index([chapterId])
  @@map("lessons")
}

enum LessonType {
  VIDEO
  DOCUMENT
  EXERCISE
  QUIZ
}

model BlogPost {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  title       String
  excerpt     String?
  content     String   @db.Text
  coverImage  String?  @map("cover_image")
  author      String
  category    String
  tags        String[] @default([])
  publishedAt DateTime @default(now()) @map("published_at")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("blog_posts")
}

// ============ 学习进度 ============
model UserProgress {
  // 归属字段
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  lessonId String @map("lesson_id") @db.Uuid

  // 内容字段
  progress     Float   @default(0) // 0-100
  isCompleted  Boolean @default(false) @map("is_completed")
  lastPosition Int?    @map("last_position") // 视频最后播放位置(秒)

  // 状态 / 审计字段
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("user_progress")
}

model Question {
  // 归属字段
  id        String  @id @default(uuid()) @db.Uuid
  subjectId String? @map("subject_id") @db.Uuid
  chapterId String? @map("chapter_id") @db.Uuid // 改为可选，支持未分类题目
  groupId   String? @map("group_id") @db.Uuid

  // 内容字段
  curriculum  String       @default("UEC")
  grade       Int?
  difficulty  Int          @default(3) // 1-5星
  type        QuestionType
  content     String       @db.Text // 题干(Markdown+LaTeX)
  options     Json? // 选项 {"A": "...", "B": "..."}
  answer      Json // 答案 "A" 或 ["A", "C"]
  explanation String?      @db.Text // 解析
  assetUrl    String?      @map("asset_url")
  imageUrls   String[]     @default([]) @map("image_urls")

  // 来源 / 标签字段
  sourceFileId String?  @map("source_file_id") @db.Uuid
  source       String?
  tags         String[] @default([])
  isPastPaper  Boolean  @default(false) @map("is_past_paper")
  paperId      String?  @map("paper_id")
  contentHash  String?  @unique @map("content_hash") // MD5哈希（用于去重）

  // 状态 / 审核字段
  status       ContentStatus @default(DRAFT)
  qualityScore Float?        @map("quality_score") // 0-100
  reportCount  Int           @default(0) @map("report_count") // 被报错次数
  createdBy    String?       @map("created_by") @db.Uuid
  reviewedBy   String?       @map("reviewed_by") @db.Uuid
  publishedBy  String?       @map("published_by") @db.Uuid
  deletedBy    String?       @map("deleted_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at")
  reviewedAt   DateTime?     @map("reviewed_at")
  publishedAt  DateTime?     @map("published_at")
  deletedAt    DateTime?     @map("deleted_at")
  deleteReason String?       @map("delete_reason") @db.Text

  // Relations
  chapter    Chapter?         @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  group      QuestionGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  subject    Subject?         @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  sourceFile SourceFile?      @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)
  attempts   UserAttempt[]
  reports    QuestionReport[]

  @@index([chapterId])
  @@index([groupId])
  @@index([subjectId])
  @@index([sourceFileId])
  @@index([curriculum])
  @@index([grade])
  @@index([difficulty])
  @@index([status])
  @@index([deletedAt])
  @@index([deletedBy])
  @@index([contentHash])
  @@index([isPastPaper])
  @@index([paperId])
  @@index([subjectId, curriculum, grade, status, isPastPaper])
  @@map("questions")
}

model QuestionGroup {
  // 归属字段
  id           String  @id @default(uuid()) @db.Uuid
  subjectId    String? @map("subject_id") @db.Uuid
  chapterId    String? @map("chapter_id") @db.Uuid
  sourceFileId String? @map("source_file_id") @db.Uuid

  // 内容字段
  curriculum String  @default("UEC")
  grade      Int?
  title      String?
  material   String  @db.Text
  assetUrl   String?  @map("asset_url")
  imageUrls  String[] @default([]) @map("image_urls")

  // 来源 / 标签字段
  source      String?
  tags        String[] @default([])
  isPastPaper Boolean  @default(false) @map("is_past_paper")
  paperId     String?  @map("paper_id")
  contentHash String?  @unique @map("content_hash")

  // 状态 / 审核字段
  status       ContentStatus @default(DRAFT)
  createdBy    String?       @map("created_by") @db.Uuid
  reviewedBy   String?       @map("reviewed_by") @db.Uuid
  publishedBy  String?       @map("published_by") @db.Uuid
  deletedBy    String?       @map("deleted_by") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at")
  reviewedAt   DateTime?     @map("reviewed_at")
  publishedAt  DateTime?     @map("published_at")
  deletedAt    DateTime?     @map("deleted_at")
  deleteReason String?       @map("delete_reason") @db.Text

  // Relations
  chapter    Chapter?    @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  questions  Question[]
  subject    Subject?    @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  sourceFile SourceFile? @relation(fields: [sourceFileId], references: [id], onDelete: SetNull)

  @@index([chapterId])
  @@index([subjectId])
  @@index([sourceFileId])
  @@index([curriculum])
  @@index([grade])
  @@index([status])
  @@index([deletedAt])
  @@index([paperId])
  @@index([contentHash])
  @@index([subjectId, curriculum, grade, status, isPastPaper])
  @@map("question_groups")
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  FILL_BLANK
  ESSAY
  TRUE_FALSE // 判断题
  MCQ // Legacy support if needed, otherwise rely on SINGLE/MULTIPLE_CHOICE
}

model UserAttempt {
  // 归属字段
  id           String  @id @default(uuid()) @db.Uuid
  userId       String  @map("user_id") @db.Uuid
  questionId   String  @map("question_id") @db.Uuid
  examRecordId String? @map("exam_record_id") @db.Uuid

  // 内容字段
  userAnswer Json    @map("user_answer")
  isCorrect  Boolean @map("is_correct")
  duration   Int? // Time taken in seconds

  // 状态 / 审计字段
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  examRecord ExamRecord? @relation(fields: [examRecordId], references: [id])

  @@index([userId])
  @@index([questionId])
  @@index([examRecordId])
  @@index([createdAt])
  @@index([userId, createdAt]) // For daily quota checks
  @@index([userId, questionId]) // For mastery calculation
  @@map("user_attempts")
}

model ExamRecord {
  // 归属字段
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @map("user_id") @db.Uuid
  subjectId String? @map("subject_id") @db.Uuid // 关联科目
  chapterId String? @map("chapter_id") @db.Uuid
  clientSessionId String? @map("client_session_id")

  // 内容字段
  title          String?
  mode           PracticeMode @default(MOCK_EXAM) // 练习模式
  score          Float
  totalQuestions Int          @map("total_questions")
  correctCount   Int          @map("correct_count")
  duration       Int? // Time taken in seconds

  // 状态 / 审计字段
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject  Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  attempts UserAttempt[]

  @@index([userId])
  @@index([subjectId])
  @@index([mode])
  @@index([clientSessionId])
  @@unique([userId, clientSessionId])
  @@map("exam_records")
}

// ============ 游戏化模块 ============

model DailyTask {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  type         DailyTaskType
  title        String
  targetCount  Int           @map("target_count")
  currentCount Int           @default(0) @map("current_count")
  xpReward     Int           @default(0) @map("xp_reward")
  isClaimed    Boolean       @default(false) @map("is_claimed")
  date         DateTime      @default(now()) @db.Date // Store only date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("daily_tasks")
}

enum DailyTaskType {
  LOGIN
  COMPLETE_LESSON
  FIX_ERROR
  QUIZ_SCORE
  ONBOARDING_PROFILE
  ONBOARDING_GOALS
  ONBOARDING_ASSESSMENT
}

// ============ 社区模块 ============
model Post {
  id        String   @id @default(uuid()) @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  title     String
  content   String   @db.Text
  category  String? // Question, Note, Achievement
  tags      String[] @default([])
  attachments String[] @default([])
  mentionedUserIds String[] @default([]) @map("mentioned_user_ids")
  mentionedHandles String[] @default([]) @map("mentioned_handles")
  subjectId String?  @map("subject_id") @db.Uuid
  isPrivate Boolean  @default(false) @map("is_private")
  likeCount Int      @default(0) @map("like_count")
  isSolved  Boolean  @default(false) @map("is_solved")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  author   User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  subject  Subject?   @relation(fields: [subjectId], references: [id])
  comments Comment[]
  likes    PostLike[]
  bookmarks PostBookmark[]

  @@index([authorId])
  @@index([createdAt])
  @@map("posts")
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  postId     String   @map("post_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  content    String   @db.Text
  mentionedUserIds String[] @default([]) @map("mentioned_user_ids")
  mentionedHandles String[] @default([]) @map("mentioned_handles")
  isSolution Boolean  @default(false) @map("is_solution")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("comments")
}

model PostLike {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("post_likes")
}

model PostBookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("post_bookmarks")
}

model ContactSubmission {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  email     String
  subject   String
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("contact_submissions")
}

enum ContactStatus {
  NEW
  READ
  REPLIED
}

// ============ 排行榜模块 ============
model LeaderboardEntry {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  score     Int               @default(0)
  rank      Int? // 缓存排名
  period    LeaderboardPeriod @default(WEEKLY)
  weekStart DateTime          @map("week_start")
  updatedAt DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, weekStart])
  @@index([period, weekStart, score(sort: Desc)])
  @@index([userId])
  @@map("leaderboard_entries")
}

enum LeaderboardPeriod {
  WEEKLY
  MONTHLY
  ALL_TIME
}

enum RewardRuleSource {
  DAILY_TASK
  ONBOARDING
  XP_CONSTANT
  ADMIN_CUSTOM
}

enum AchievementRuleSource {
  BADGE_DEFINITION
  ADMIN_CUSTOM
}

