generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ 用户模块 ============
model User {
  id             String    @id @default(uuid()) @db.Uuid
  email          String    @unique
  username       String?   @unique
  role           UserRole  @default(STUDENT)
  avatar         String?
  grade          Int? // 年级 (7-9)
  streak         Int       @default(0)
  totalStudyTime Int       @default(0) @map("total_study_time") // seconds
  xp             Int       @default(0)
  aiTokenBalance Int       @default(5) @map("ai_token_balance") // Free daily quota or permanent balance
  lastStudyDate  DateTime? @map("last_study_date")

  // Tracking & Growth
  lastSignInAt DateTime? @map("last_sign_in_at")
  signInCount  Int       @default(0) @map("sign_in_count")
  utmSource    String?   @map("utm_source")
  utmMedium    String?   @map("utm_medium")
  utmCampaign  String?   @map("utm_campaign")

  // 推荐系统
  referralCode  String? @unique @map("referral_code") // 用户的推荐码（唯一）
  referralCount Int     @default(0) @map("referral_count") // 成功推荐数量
  referralLimit Int     @default(10) @map("referral_limit") // 推荐上限

  // 订阅相关
  subscriptionTier  UserRole? @map("subscription_tier") // PRO/ULTIMATE
  subscriptionStart DateTime? @map("subscription_start")
  subscriptionEnd   DateTime? @map("subscription_end")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  settings           UserSettings?
  progress           UserProgress[]
  attempts           UserAttempt[]
  examRecords        ExamRecord[]
  errorBook          ErrorBook[]
  posts              Post[]
  comments           Comment[]
  leaderboardEntries LeaderboardEntry[]
  badges             UserBadge[]
  dailyTasks         DailyTask[]
  postLikes          PostLike[]

  // Parent-Student Relations
  parents     ParentStudent[] @relation("StudentToParent")
  students    ParentStudent[] @relation("ParentToStudent")
  inviteCodes InviteCode[]

  // Referral Relations
  referralsGiven    Referral[] @relation("Referrer") // 我推荐的人
  referralsReceived Referral[] @relation("Referee") // 推荐我的人

  // 🆕 Content Pipeline 关联 (Story-044)
  uploadedSourceFiles SourceFile[]       @relation("UserUploadedFiles")
  reviewLogs          ContentReviewLog[] @relation("UserReviewLogs")
  questionReports     QuestionReport[]   @relation("UserQuestionReports")

  // 🆕 用户管理后台关联 (Story-046)
  adminNotes            AdminNote[]
  securityLogs          SecurityLog[]
  impersonationSessions ImpersonationSession[]

  @@map("users")
}

model ParentStudent {
  id        String   @id @default(uuid()) @db.Uuid
  parentId  String   @map("parent_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  parent  User @relation("ParentToStudent", fields: [parentId], references: [id], onDelete: Cascade)
  student User @relation("StudentToParent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@map("parent_students")
}

model InviteCode {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique
  studentId String   @map("student_id") @db.Uuid
  expiresAt DateTime @map("expires_at")
  used      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("invite_codes")
}

model UserSettings {
  id                    String        @id @default(uuid()) @db.Uuid
  userId                String        @unique @map("user_id") @db.Uuid
  theme                 String        @default("dark")
  language              String        @default("en") // 'en', 'zh', 'ms'
  aiPersonality         AiPersonality @default(ENCOURAGING) @map("ai_personality")
  difficultyCalibration Int           @default(50) @map("difficulty_calibration") // 0-100
  curriculumSystem      String?       @map("curriculum_system") // e.g. "UEC", "IGCSE"

  // Notifications & Reminders
  studyReminderTime  String? @map("study_reminder_time") // e.g. "20:00"
  notificationDaily  Boolean @default(true) @map("notification_daily") // Push/In-app
  notificationWeekly Boolean @default(true) @map("notification_weekly") // Push/In-app
  emailMarketing     Boolean @default(true) @map("email_marketing")
  emailActivity      Boolean @default(true) @map("email_activity")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

enum AiPersonality {
  ENCOURAGING
  SOCRATIC
  STRICT
}

enum UserRole {
  STUDENT
  PARENT
  PRO
  ULTIMATE
  TEACHER
  ADMIN
}

model Subscriber {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  subscribedAt DateTime @default(now()) @map("subscribed_at")

  @@map("subscribers")
}

// ============ 成就系统 ============
model Badge {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique // e.g. "early_bird", "math_master"
  name        String
  description String
  icon        String // URL or icon name
  condition   String? // Description of how to unlock
  createdAt   DateTime @default(now()) @map("created_at")

  users UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  badgeId   String   @map("badge_id") @db.Uuid
  awardedAt DateTime @default(now()) @map("awarded_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

// ============ 课程模块 ============
model Subject {
  id    String  @id @default(uuid()) @db.Uuid
  name  String  @unique // 数学, 物理, 化学...
  icon  String?
  order Int     @default(0)

  chapters        Chapter[]
  posts           Post[]
  examRecords     ExamRecord[] // 🆕 练习记录关联 (Story-043)
  questionGroups  QuestionGroup[] // 🆕 Content Pipeline 关联 (Story-044)
  knowledgePoints KnowledgePoint[] // 🆕 知识点关联 (Story-044)

  @@map("subjects")
}

model Chapter {
  id        String   @id @default(uuid()) @db.Uuid
  subjectId String   @map("subject_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid // 自关联实现树形结构
  title     String
  order     Int      @default(0)
  x         Float? // For Knowledge Graph layout
  y         Float? // For Knowledge Graph layout
  createdAt DateTime @default(now()) @map("created_at")

  // 🆕 练习中心扩展字段 (Story-043)
  totalQuestions  Int       @default(0) @map("total_questions") // 该章节题目总数
  avgDifficulty   Float?    @map("avg_difficulty") // 平均难度
  cachedMastery   Json?     @map("cached_mastery") // { [userId]: masteryLevel }
  lastCacheUpdate DateTime? @map("last_cache_update") // 缓存最后更新时间

  // Relations
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent    Chapter?   @relation("ChapterTree", fields: [parentId], references: [id])
  children  Chapter[]  @relation("ChapterTree")
  lessons   Lesson[]
  questions Question[]

  // Knowledge Graph Relations (Self-relation for Graph)
  prerequisites ChapterPrerequisite[] @relation("DependentChapter")
  dependents    ChapterPrerequisite[] @relation("PrerequisiteChapter")

  @@index([subjectId])
  @@index([parentId])
  @@map("chapters")
}

model ChapterPrerequisite {
  id             String @id @default(uuid()) @db.Uuid
  prerequisiteId String @map("prerequisite_id") @db.Uuid
  dependentId    String @map("dependent_id") @db.Uuid

  prerequisite Chapter @relation("PrerequisiteChapter", fields: [prerequisiteId], references: [id], onDelete: Cascade)
  dependent    Chapter @relation("DependentChapter", fields: [dependentId], references: [id], onDelete: Cascade)

  @@unique([prerequisiteId, dependentId])
  @@map("chapter_prerequisites")
}

model Lesson {
  id        String     @id @default(uuid()) @db.Uuid
  chapterId String     @map("chapter_id") @db.Uuid
  title     String
  type      LessonType @default(VIDEO)
  videoUrl  String?    @map("video_url")
  content   String?    @db.Text // Markdown 内容
  duration  Int? // 视频时长(秒)
  xpReward  Int        @default(10) @map("xp_reward")
  order     Int        @default(0)
  createdAt DateTime   @default(now()) @map("created_at")

  // Relations
  chapter  Chapter        @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  progress UserProgress[]

  @@index([chapterId])
  @@map("lessons")
}

enum LessonType {
  VIDEO
  DOCUMENT
  EXERCISE
  QUIZ
}

model BlogPost {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  title       String
  excerpt     String?
  content     String   @db.Text
  coverImage  String?  @map("cover_image")
  author      String
  category    String
  tags        String[] @default([])
  publishedAt DateTime @default(now()) @map("published_at")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("blog_posts")
}

// ============ 学习进度 ============
model UserProgress {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  lessonId     String   @map("lesson_id") @db.Uuid
  progress     Float    @default(0) // 0-100
  isCompleted  Boolean  @default(false) @map("is_completed")
  lastPosition Int?     @map("last_position") // 视频最后播放位置(秒)
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@map("user_progress")
}

// ============ 题库模块 ============
model Question {
  id          String       @id @default(uuid()) @db.Uuid
  chapterId   String?      @map("chapter_id") @db.Uuid // 改为可选，支持未分类题目
  type        QuestionType
  difficulty  Int          @default(3) // 1-5星
  content     String       @db.Text // 题干(Markdown+LaTeX)
  options     Json? // 选项 {"A": "...", "B": "..."}
  answer      Json // 答案 "A" 或 ["A", "C"]
  explanation String?      @db.Text // 解析
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @default(now()) @updatedAt @map("updated_at")

  // 🆕 Content Pipeline 扩展字段 (Story-044)
  groupId String?        @map("group_id") @db.Uuid // 组合题关联
  group   QuestionGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // 状态与版本控制
  status             ContentStatus @default(DRAFT)
  version            Int           @default(1)
  originalQuestionId String?       @map("original_question_id") @db.Uuid // 版本追溯

  // OCR数据（用于回溯）
  ocrRawText    String? @map("ocr_raw_text") @db.Text
  ocrConfidence Float?  @map("ocr_confidence") // 0-1
  contentHash   String? @unique @map("content_hash") // MD5哈希（用于去重）

  // 质量评分
  qualityScore Float? @map("quality_score") // 0-100
  reportCount  Int    @default(0) @map("report_count") // 被报错次数

  // 审计字段
  createdBy   String?   @map("created_by") @db.Uuid
  reviewedBy  String?   @map("reviewed_by") @db.Uuid
  publishedBy String?   @map("published_by") @db.Uuid
  reviewedAt  DateTime? @map("reviewed_at")
  publishedAt DateTime? @map("published_at")

  // Relations
  chapter   Chapter?      @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  attempts  UserAttempt[]
  errorBook ErrorBook[]

  // 🆕 Content Pipeline 关联 (Story-044)
  tags            QuestionTagRelation[]
  knowledgePoints KnowledgePointRelation[]
  sourceFiles     SourceFile[]             @relation("SourceToQuestion")
  reports         QuestionReport[]

  @@index([chapterId])
  @@index([difficulty])
  @@index([status])
  @@index([contentHash])
  @@index([groupId])
  @@map("questions")
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  FILL_BLANK
  ESSAY
  TRUE_FALSE // 判断题
  MCQ // Legacy support if needed, otherwise rely on SINGLE/MULTIPLE_CHOICE
}

model UserAttempt {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  questionId   String   @map("question_id") @db.Uuid
  examRecordId String?  @map("exam_record_id") @db.Uuid
  userAnswer   Json     @map("user_answer")
  isCorrect    Boolean  @map("is_correct")
  duration     Int? // Time taken in seconds
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  question   Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  examRecord ExamRecord? @relation(fields: [examRecordId], references: [id])

  @@index([userId])
  @@index([questionId])
  @@index([examRecordId])
  @@index([createdAt])
  @@index([userId, createdAt]) // For daily quota checks
  @@index([userId, questionId]) // For mastery calculation
  @@map("user_attempts")
}

model ExamRecord {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  chapterId      String?  @map("chapter_id") @db.Uuid
  title          String?
  score          Float
  totalQuestions Int      @map("total_questions")
  correctCount   Int      @map("correct_count")
  duration       Int? // Time taken in seconds
  createdAt      DateTime @default(now()) @map("created_at")

  // 🆕 练习中心扩展字段 (Story-043)
  mode      PracticeMode @default(MOCK_EXAM) // 练习模式
  subjectId String?      @map("subject_id") @db.Uuid // 关联科目

  // Relations
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject  Subject?      @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  attempts UserAttempt[]

  @@index([userId])
  @@index([subjectId])
  @@index([mode])
  @@map("exam_records")
}

model ErrorBook {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  questionId   String   @map("question_id") @db.Uuid
  masteryLevel Int      @default(0) @map("mastery_level") // 0-3
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@map("error_book")
}

// ============ 游戏化模块 ============

model DailyTask {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String        @map("user_id") @db.Uuid
  type         DailyTaskType
  title        String
  targetCount  Int           @map("target_count")
  currentCount Int           @default(0) @map("current_count")
  xpReward     Int           @default(0) @map("xp_reward")
  isClaimed    Boolean       @default(false) @map("is_claimed")
  date         DateTime      @default(now()) @db.Date // Store only date

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@map("daily_tasks")
}

enum DailyTaskType {
  LOGIN
  COMPLETE_LESSON
  FIX_ERROR
  QUIZ_SCORE
  ONBOARDING_PROFILE
  ONBOARDING_GOALS
  ONBOARDING_ASSESSMENT
}

// ============ 社区模块 ============
model Post {
  id        String   @id @default(uuid()) @db.Uuid
  authorId  String   @map("author_id") @db.Uuid
  title     String
  content   String   @db.Text
  category  String? // Question, Note, Achievement
  tags      String[] @default([])
  subjectId String?  @map("subject_id") @db.Uuid
  likeCount Int      @default(0) @map("like_count")
  isSolved  Boolean  @default(false) @map("is_solved")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  author   User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  subject  Subject?   @relation(fields: [subjectId], references: [id])
  comments Comment[]
  likes    PostLike[]

  @@index([authorId])
  @@index([createdAt])
  @@map("posts")
}

model Comment {
  id         String   @id @default(uuid()) @db.Uuid
  postId     String   @map("post_id") @db.Uuid
  authorId   String   @map("author_id") @db.Uuid
  content    String   @db.Text
  isSolution Boolean  @default(false) @map("is_solution")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("comments")
}

model PostLike {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  postId    String   @map("post_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@map("post_likes")
}

model ContactSubmission {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  email     String
  subject   String
  message   String        @db.Text
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now()) @map("created_at")

  @@map("contact_submissions")
}

enum ContactStatus {
  NEW
  READ
  REPLIED
}

// ============ 排行榜模块 ============
model LeaderboardEntry {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  score     Int               @default(0)
  rank      Int? // 缓存排名
  period    LeaderboardPeriod @default(WEEKLY)
  weekStart DateTime          @map("week_start")
  updatedAt DateTime          @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, period, weekStart])
  @@index([period, weekStart, score(sort: Desc)])
  @@index([userId])
  @@map("leaderboard_entries")
}

enum LeaderboardPeriod {
  WEEKLY
  MONTHLY
  ALL_TIME
}

// ============ 练习模式枚举 ============
enum PracticeMode {
  SMART_DRILL // 智能刷题
  ERROR_WIPER // 错题复习
  MOCK_EXAM // 模拟考试
  CHAPTER_DRILL // 章节练习
  PAST_PAPER // 历年真题
}

// ============ 推荐系统模块 ============
enum ReferralStatus {
  PENDING // 被推荐人已注册，但未付费
  COMPLETED // 被推荐人已付费，奖励已发放
  EXPIRED // 推荐码过期（可选）
  CANCELLED // 被推荐人退款（可选）
}

model Referral {
  id           String @id @default(uuid()) @db.Uuid
  referrerId   String @map("referrer_id") @db.Uuid // 推荐人 ID
  refereeId    String @map("referee_id") @db.Uuid // 被推荐人 ID
  referralCode String @map("referral_code") // 使用的推荐码

  // 奖励状态
  status        ReferralStatus @default(PENDING)
  rewardGranted Boolean        @default(false) @map("reward_granted") // 奖励是否已发放
  rewardDate    DateTime?      @map("reward_date") // 奖励发放时间

  // 追踪信息
  refereeEmail  String    @map("referee_email") // 被推荐人邮箱（冗余，方便查询）
  refereePaidAt DateTime? @map("referee_paid_at") // 被推荐人首次付费时间
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referee  User @relation("Referee", fields: [refereeId], references: [id], onDelete: Cascade)

  @@unique([refereeId]) // 每个用户只能使用一次推荐码
  @@index([referrerId])
  @@index([status])
  @@map("referrals")
}

// ============ Content Pipeline 模块 (Story-044) ============

// 处理状态枚举
enum ProcessingStatus {
  PENDING // 等待处理
  PROCESSING // 处理中
  COMPLETED // 处理完成
  FAILED // 处理失败
  SKIPPED // 跳过处理
}

// 内容状态枚举
enum ContentStatus {
  DRAFT // 草稿
  OCR_PROCESSING // OCR处理中
  OCR_COMPLETED // OCR完成
  STRUCTURING // 结构化中
  REVIEW_PENDING // 待审核
  REVIEW_REJECTED // 审核拒绝
  VERIFIED // 已验证
  PUBLISHED // 已发布
  ARCHIVED // 已归档
}

// 标签分类枚举
enum TagCategory {
  SUBJECT // 科目
  TOPIC // 知识点
  DIFFICULTY // 难度
  COGNITIVE_LEVEL // 认知层级（布鲁姆分类）
  QUESTION_TYPE // 题型
  SOURCE // 来源（真题/模拟题）
}

// 审核操作枚举
enum ReviewAction {
  SUBMIT_REVIEW // 提交审核
  APPROVE // 通过
  REJECT // 拒绝
  REQUEST_CHANGE // 请求修改
  PUBLISH // 发布
  ARCHIVE // 归档
}

// 报告问题类型枚举
enum ReportIssueType {
  ANSWER_WRONG // 答案错误
  TYPO // 错别字
  UNCLEAR // 表述不清
  IMAGE_BROKEN // 图片损坏
  LATEX_ERROR // 公式错误
  OTHER // 其他
}

// 报告状态枚举
enum ReportStatus {
  PENDING // 待处理
  REVIEWING // 审核中
  RESOLVED // 已解决
  REJECTED // 无效报告
}

// ==================== 源文件管理 ====================
model SourceFile {
  id       String @id @default(uuid()) @db.Uuid
  filename String
  fileUrl  String @map("file_url") // Supabase Storage URL
  fileType String @map("file_type") // "pdf" | "image" | "docx"
  fileSize Int    @map("file_size") // bytes

  // 处理状态
  status     ProcessingStatus @default(PENDING)
  ocrStatus  ProcessingStatus @default(PENDING) @map("ocr_status")
  ocrRawText String?          @map("ocr_raw_text") @db.Text // OCR原始输出

  // 关联
  questionGroups QuestionGroup[] @relation("SourceToGroup")
  questions      Question[]      @relation("SourceToQuestion")

  // 审计
  uploadedBy  String    @map("uploaded_by") @db.Uuid
  uploader    User      @relation("UserUploadedFiles", fields: [uploadedBy], references: [id])
  createdAt   DateTime  @default(now()) @map("created_at")
  processedAt DateTime? @map("processed_at")

  @@index([uploadedBy])
  @@index([status])
  @@map("source_files")
}

// ==================== 组合题/题组 ====================
model QuestionGroup {
  id          String  @id @default(uuid()) @db.Uuid
  content     String  @db.Text // 公共题干（支持Markdown + LaTeX）
  materialUrl String? @map("material_url") // 辅助资源URL（图片/音频）

  // 元数据
  subjectId   String  @map("subject_id") @db.Uuid
  subject     Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  source      String? // 来源标识 (e.g. "2023年中考数学真题")
  sourceYear  Int?    @map("source_year") // 年份
  sourcePaper String? @map("source_paper") // 试卷名

  // 状态与版本
  status  ContentStatus @default(DRAFT)
  version Int           @default(1)

  // 关联
  questions   Question[]
  sourceFiles SourceFile[] @relation("SourceToGroup")

  // 审计字段
  createdBy   String?   @map("created_by") @db.Uuid
  reviewedBy  String?   @map("reviewed_by") @db.Uuid
  publishedBy String?   @map("published_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  reviewedAt  DateTime? @map("reviewed_at")
  publishedAt DateTime? @map("published_at")

  @@index([subjectId])
  @@index([status])
  @@map("question_groups")
}

// ==================== 标签体系 ====================
model QuestionTag {
  id       String      @id @default(uuid()) @db.Uuid
  name     String      @unique // "函数"、"导数"
  category TagCategory
  color    String? // 标签颜色

  // 层级结构
  parentId String?       @map("parent_id") @db.Uuid
  parent   QuestionTag?  @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children QuestionTag[] @relation("TagHierarchy")

  // 关联
  questions QuestionTagRelation[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([category])
  @@index([parentId])
  @@map("question_tags")
}

// 多对多关联表：题目-标签
model QuestionTagRelation {
  questionId String @map("question_id") @db.Uuid
  tagId      String @map("tag_id") @db.Uuid

  question Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      QuestionTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([questionId, tagId])
  @@index([tagId])
  @@map("question_tag_relations")
}

// ==================== 知识点体系 ====================
model KnowledgePoint {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique // "MATH-001-001"
  name        String // "一元一次方程"
  description String? @db.Text

  subjectId String  @map("subject_id") @db.Uuid
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  // 层级结构
  parentId String?          @map("parent_id") @db.Uuid
  parent   KnowledgePoint?  @relation("KPHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children KnowledgePoint[] @relation("KPHierarchy")

  // 关联
  questions KnowledgePointRelation[]

  createdAt DateTime @default(now()) @map("created_at")

  @@index([subjectId])
  @@index([parentId])
  @@map("knowledge_points")
}

// 多对多关联表：题目-知识点
model KnowledgePointRelation {
  questionId String @map("question_id") @db.Uuid
  kpId       String @map("kp_id") @db.Uuid

  question Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  kp       KnowledgePoint @relation(fields: [kpId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  @@id([questionId, kpId])
  @@index([kpId])
  @@map("question_kp_relations")
}

// ==================== 审核日志 ====================
model ContentReviewLog {
  id          String @id @default(uuid()) @db.Uuid
  contentType String @map("content_type") // "question" | "question_group"
  contentId   String @map("content_id") @db.Uuid

  action     ReviewAction
  fromStatus ContentStatus @map("from_status")
  toStatus   ContentStatus @map("to_status")

  reviewerId String @map("reviewer_id") @db.Uuid
  reviewer   User   @relation("UserReviewLogs", fields: [reviewerId], references: [id])

  comment String? @db.Text // 审核意见
  changes Json? // 修改内容（JSON diff）

  createdAt DateTime @default(now()) @map("created_at")

  @@index([contentType, contentId])
  @@index([reviewerId])
  @@map("content_review_logs")
}

// ==================== 用户纠错 ====================
model QuestionReport {
  id         String   @id @default(uuid()) @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  reportedBy String @map("reported_by") @db.Uuid
  reporter   User   @relation("UserQuestionReports", fields: [reportedBy], references: [id])

  issueType   ReportIssueType @map("issue_type")
  description String          @db.Text
  status      ReportStatus    @default(PENDING)

  // 审核处理
  reviewedBy String?   @map("reviewed_by") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at")
  resolution String?   @db.Text // 处理结果

  createdAt DateTime @default(now()) @map("created_at")

  @@index([questionId])
  @@index([status])
  @@index([reportedBy])
  @@map("question_reports")
}

// ============ 用户管理后台模块 (Story-046) ============

// 安全操作类型枚举
enum SecurityAction {
  LOGIN
  LOGOUT
  PASSWORD_RESET
  IMPERSONATE_START // 伪装登录：进入
  IMPERSONATE_END // 伪装登录：退出
  USER_BANNED
  USER_UNBANNED
  PERMISSION_OVERRIDE // 权限覆写
  ADMIN_NOTE_ADDED
  ADMIN_NOTE_DELETED // 软删除操作
  ADMIN_NOTE_RESTORED // 恢复操作
}

// 客服/运营内部备注（用户不可见，支持软删除）
model AdminNote {
  id       String @id @default(uuid()) @db.Uuid
  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorId String @map("author_id") @db.Uuid // 操作者 Admin ID
  content  String @db.Text // Markdown 格式
  isPinned Boolean @default(false) @map("is_pinned")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at") // 软删除时间

  @@index([userId])
  @@index([userId, deletedAt])
  @@map("admin_notes")
}

// 安全审计日志
model SecurityLog {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    SecurityAction
  ipAddress String?        @map("ip_address")
  userAgent String?        @map("user_agent")
  metadata  Json? // 附加上下文

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([userId, createdAt])
  @@map("security_logs")
}

// 伪装登录会话
model ImpersonationSession {
  id           String   @id @default(uuid()) @db.Uuid
  adminId      String   @map("admin_id") @db.Uuid // 发起伪装的 Admin
  targetUserId String   @map("target_user_id") @db.Uuid // 被伪装的用户
  targetUser   User     @relation(fields: [targetUserId], references: [id], onDelete: Cascade)
  token        String // 签发的 JWT
  startedAt    DateTime @default(now()) @map("started_at")
  expiresAt    DateTime @map("expires_at") // Token 过期时间
  endedAt      DateTime? @map("ended_at") // 实际退出时间
  endReason    String?  @map("end_reason") // MANUAL_LOGOUT | TOKEN_EXPIRED | ADMIN_REVOKED

  @@index([targetUserId])
  @@index([adminId, startedAt])
  @@map("impersonation_sessions")
}
