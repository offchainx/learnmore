  operatorName   String                 @map("operator_name")
  operatorAvatar String?                @map("operator_avatar")
  result         RewardAdminAuditResult
  comment        String?                @db.Text
  beforeSnapshot String?                @map("before_snapshot") @db.Text
  afterSnapshot  String?                @map("after_snapshot") @db.Text
